+            /// The HTML escaping every template uses unless told otherwise.
+            static void html_escape(const std::string& in, std::string& out)
+            {
+                out.reserve(out.size() + in.size());
+                for (auto it = in.begin(); it != in.end(); ++it)
+                {
+                    switch (*it)
+                    {
+                        case '&': out += "&amp;"; break;
+                        case '<': out += "&lt;"; break;
+                        case '>': out += "&gt;"; break;
+                        case '"': out += "&quot;"; break;
+                        case '\'': out += "&#39;"; break;
+                        case '/': out += "&#x2F;"; break;
+                        case '`': out += "&#x60;"; break;
+                        case '=': out += "&#x3D;"; break;
+                        default: out += *it; break;
+                    }
+                }
+            }
+
+            /// Replaces the escaping of `{{ name }}` for this template (and the
+            /// partials and lambdas it renders). nullptr restores HTML escaping.
+            void set_escape(escape_function fn)
+            {
+                escape_fn_ = fn != nullptr ? fn : &template_t::html_escape;
+            }
+
+            escape_function get_escape() const
+            {
+                return escape_fn_;
+            }
