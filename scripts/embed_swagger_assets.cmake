# Generates a C++ source embedding the vendored Swagger UI files (cmake -P).
#
#   cmake -DDIR=<dir holding the files> -DOUT=<generated .cpp> \
#         "-DFILES=name:content-type,name:content-type" -P embed_swagger_assets.cmake
#
# Each file becomes a byte array, and FindSwaggerUiAsset(name) maps a file name to
# it. Run by an add_custom_command in CMakeLists.txt, so the output is rebuilt
# only when a vendored file changes.

string(REPLACE "," ";" FILES "${FILES}")
set(body "// Generated by scripts/embed_swagger_assets.cmake. Do not edit.\n")
string(APPEND body "#include \"swagger_ui_assets.hpp\"\n\nnamespace flapi {\nnamespace {\n")

set(table "")
set(index 0)
foreach(entry IN LISTS FILES)
    string(REPLACE ":" ";" parts "${entry}")
    list(GET parts 0 name)
    list(GET parts 1 content_type)
    file(READ "${DIR}/${name}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Wrapped, so no line is megabytes long (a compiler limit on some toolchains).
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\\1\n" bytes "${bytes}")
    string(APPEND body "const unsigned char kAsset${index}[] = {\n${bytes}\n};\n")
    string(APPEND table "    {\"${name}\", \"${content_type}\", kAsset${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()

string(APPEND body "\nconst SwaggerUiAsset kAssets[] = {\n${table}};\n}  // namespace\n\n")
string(APPEND body "const SwaggerUiAsset* FindSwaggerUiAsset(std::string_view name) {\n")
string(APPEND body "    for (const auto& asset : kAssets) {\n")
string(APPEND body "        if (name == asset.name) {\n            return &asset;\n        }\n    }\n")
string(APPEND body "    return nullptr;\n}\n\n}  // namespace flapi\n")

file(WRITE "${OUT}" "${body}")
